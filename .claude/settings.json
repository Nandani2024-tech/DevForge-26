{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git show *)",
      "Edit(.hackathon/**)",
      "Edit(**/tests/**)",
      "Edit(**/test/**)",
      "Edit(**/__tests__/**)",
      "Edit(**/*.test.*)",
      "Edit(**/*.spec.*)",
      "Edit(**/test_*.py)",
      "Edit(**/*_test.py)",
      "Edit(**/*_test.go)",
      "Bash(npm test*)",
      "Bash(npm run test*)",
      "Bash(npx vitest*)",
      "Bash(npx jest*)",
      "Bash(pnpm test*)",
      "Bash(yarn test*)",
      "Bash(pytest*)",
      "Bash(python -m pytest*)",
      "Bash(python3 -m pytest*)",
      "Bash(uv run pytest*)",
      "Bash(go test*)",
      "Bash(cargo test*)",
      "Bash(mvn test*)",
      "Bash(./gradlew test*)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git stash*)",
      "Bash(git restore*)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git rebase*)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(git add -- .)",
      "Bash(git add -u*)",
      "Bash(git add --update*)",
      "Bash(git add :/*)",
      "Bash(git commit -a*)",
      "Bash(git commit --all*)",
      "Bash(git commit --amend*)",
      "Bash(git commit * --amend*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n *)"
    ]
  }
}
